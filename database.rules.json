{
  "rules": {
    "allow": {
      "$email": {
        ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $email",
        ".write": false
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && root.child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        "peers": {
          "$peer": {
            ".write": "auth != null && root.child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && $peer.beginsWith(auth.uid.substring(0, 6))",
            ".validate": "newData.child('j').isString() && newData.child('j').val().length < 6000"
          }
        }
      }
    }
  }
}
