+  const ae=document.activeElement,kb=vh<FIT.fullH*.8&&!!ae&&b.contains(ae)&&/^(INPUT|TEXTAREA)$/.test(ae.tagName);
+  if(de.classList.contains('fitkb')!==kb)de.classList.toggle('fitkb',kb);
